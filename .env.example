# =============================================================================
# Nexora AI — Environment Configuration
# Copy to .env and fill in real values
# NEVER commit .env to version control
# =============================================================================

# App
APP_NAME=Nexora AI
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://nexora:nexora_pass@postgres:5432/nexora_db
DATABASE_SYNC_URL=postgresql://nexora:nexora_pass@postgres:5432/nexora_db

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ (Celery broker)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# MinIO (Object Storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=nexora_access
MINIO_SECRET_KEY=nexora_secret
MINIO_BUCKET=nexora-storage
MINIO_SECURE=false

# AI Providers
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GEMINI_API_KEY=your-gemini-key
DEEPSEEK_API_KEY=your-deepseek-key
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_MODEL=openrouter/free
DEFAULT_AI_PROVIDER=openrouter

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,https://your-domain.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Upload
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.xlsx,.csv,.txt,.png,.jpg,.jpeg,.webp

# Features
OCR_ENABLED=true
AGENT_FRAMEWORK_ENABLED=true
AGENT_ASYNC_CHAR_THRESHOLD=2000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Monitoring (optional)
SENTRY_DSN=
PROMETHEUS_ENABLED=false
