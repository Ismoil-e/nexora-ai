# Nexora AI Backend Configuration

# App
APP_NAME=Nexora AI
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=your-secret-key-here-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://nexora:nexora_pass@localhost:5432/nexora_db
DATABASE_SYNC_URL=postgresql+psycopg2://nexora:nexora_pass@localhost:5432/nexora_db

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# MinIO (S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=nexora_access
MINIO_SECRET_KEY=nexora_secret
MINIO_BUCKET=nexora-storage
MINIO_SECURE=false

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=AIzaSyC5vYonQWe45z07J5lIitdIfTDTqUw2BmU
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_AI_PROVIDER=gemini

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Upload
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.xlsx,.csv,.txt,.png,.jpg,.jpeg,.webp

# OCR
OCR_ENABLED=true
